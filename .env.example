# Database
MONGODB_URI=mongodb://localhost:27017/life-hub
# Or Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/life-hub?retryWrites=true&w=majority

# NextAuth / Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Timezone (default: Asia/Ho_Chi_Minh)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Ho_Chi_Minh

# Cloudinary Image Upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=life_hub_preset

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed admin user
SEED_ADMIN_EMAIL=admin@lifehub.local
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_NAME="Personal Life Admin"
