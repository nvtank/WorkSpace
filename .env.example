# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO VERCEL & PRODUCTION
# ==========================================

# 1. Database (Bắt buộc - Sử dụng MongoDB Atlas miễn phí)
# Đăng ký tại https://www.mongodb.com/cloud/atlas -> Tạo cluster M0 Free -> Lấy chuỗi kết nối
# Lưu ý: Vào Network Access trên Atlas -> Add IP Address: 0.0.0.0/0 (Allow from Anywhere)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/life-hub?retryWrites=true&w=majority

# 2. Authentication / NextAuth (Bắt buộc)
# Tạo chuỗi bí mật bằng lệnh: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_random_string_here
NEXTAUTH_URL=https://your-project.vercel.app

# 3. App Config
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
NEXT_PUBLIC_APP_TIMEZONE=Asia/Ho_Chi_Minh

# 4. Cloudinary - Lưu trữ hình ảnh ghi chú (Tùy chọn)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# 5. Thông tin Admin mặc định khi chạy seed (Tùy chọn)
SEED_ADMIN_EMAIL=admin@lifehub.local
SEED_ADMIN_PASSWORD=YourStrongPassword123!
SEED_ADMIN_NAME="Nguyễn Văn Tuấn Anh"
